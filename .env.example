# Diisi otomatis oleh Vercel saat Anda menambahkan integrasi "Upstash for Redis"
# dari Vercel Marketplace dan menghubungkannya ke project ini (lihat README.md
# bagian Setup). Untuk dev lokal, jalankan: npx vercel env pull .env.local
#
# Tergantung versi integrasinya, Vercel akan mengisi salah satu dari dua
# pasangan variabel ini (kode sudah mendukung keduanya):
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
